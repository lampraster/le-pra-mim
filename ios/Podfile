# ONNX Runtime oficial da Microsoft. O pacote Swift oficial (onnxruntime-swift-package-manager) saiu do ar;
# o pod onnxruntime-objc continua publicado pela Microsoft e baixa a biblioteca de download.onnxruntime.ai.
platform :ios, '16.0'
project 'LePraMim.xcodeproj'
use_frameworks! :linkage => :static

target 'LePraMim' do
  pod 'onnxruntime-objc', '1.28.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
